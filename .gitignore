node_modules/
dist/

# Segredos — nunca commitar
.env
.env.*
!.env.example

# Sessão do WhatsApp (Baileys) — são credenciais do número pareado
.whatsapp/

# Sessão do navegador da conta gerente do Google. Vazar esta pasta é entregar
# a conta inteira: ela contém cookies de sessão já autenticados, que passam
# direto pela senha e pela verificação em duas etapas.
.google/

# Fotos e HTML salvos pelo diagnóstico — carregam a tela logada da conta.
diagnostico-*.png
diagnostico-*.html

# Logs e temporários
*.log
npm-debug.log*
.DS_Store
.supabase/

# Prints para divulgação — material de marketing, gerado sob demanda
prints/

# Fotos das telas tiradas por `npm run telas`. São geradas a cada rodada e
# não descrevem o código — o que vale conferir é o JSON de dados de mentira.
.telas/
